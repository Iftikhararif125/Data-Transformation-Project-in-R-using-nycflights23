Five Questions for Data Transformation
Which destinations are served most frequently from JFK Airport?
(Filter flights by origin = "JFK", count flights per destination, sort in descending order, and join with the airports dataset to display full airport names.)

Which airlines operate the most flights from JFK to LAX?
(Filter flights for JFK → LAX, group by carrier, count flights per airline, sort, and join with the airlines dataset to show airline names.)

Which airlines flew the JFK → LAX route on January 1st, and at what scheduled times?
(Further filter by month = 1 and day = 1, group by carrier, and arrange results by scheduled departure time.)

Which airline had the highest average departure and arrival delays on the JFK → LAX route on January 1st?
(Group by carrier and summarize mean dep_delay and arr_delay, excluding missing values.)

Which airline carried the most total seat capacity on the JFK → LAX route on January 1st?
(Join flights with the planes dataset by tailnum, group by carrier, and sum the seats column; optionally join with airlines to display carrier names.)

 
library(nycflights23)
library(dplyr)
library(magrittr)

airports %>% head()

airports %>% filter(faa %in% c('JFK', 'BTV', 'SEA')) %>% 
  select(faa, name)

flights %>% filter(origin == 'JFK') %>% select(dest) %>% table()

flights %>% filter(origin == 'JFK') %>% select(dest) %>% 
  group_by(dest) %>% summarise(num = n()) 

flights %>% filter(origin == 'JFK') %>% select(dest) %>% 
  group_by(dest) %>% summarise(num = n()) %>% arrange(desc(num))

flights %>% filter(origin == 'JFK') %>% select(dest) %>% 
  group_by(dest) %>% summarise(num = n()) %>% arrange(desc(num)) %>% 
  left_join(airports, by = c('dest' = 'faa')) %>% select(name, dest, num)

flights %>% filter(origin == 'JFK' & dest == "LAX") %>% select(carrier) %>% 
  group_by(carrier) %>% summarise(num = n())

flights %>% filter(origin == 'JFK' & dest == "LAX") %>% select(carrier) %>% 
  group_by(carrier) %>% summarise(num = n()) %>% arrange(num)

flights %>% filter(origin == 'JFK' & dest == "LAX") %>% select(carrier) %>% 
  group_by(carrier) %>% summarise(num = n()) %>% arrange(desc(num)) %>% 
  left_join(airlines, by = 'carrier') %>% select(name, carrier, num)

flights %>% filter(origin == 'JFK' & dest == "LAX" & month == 1 & day == 1) %>% 
  select(carrier) %>% 
  group_by(carrier) %>% summarise(num = n()) %>% arrange(desc(num)) %>% 
  left_join(airlines, by = 'carrier') %>% select(name, carrier, num)

flights %>% filter(origin == 'JFK' & dest == "LAX" & month == 1 & day == 1) %>% 
  select(carrier, sched_dep_time)

flights %>% filter(origin == 'JFK' & dest == "LAX" & month == 1 & day == 1) %>% 
  select(carrier, sched_dep_time) %>% left_join(airlines, by = 'carrier') %>% 
  select(carrier, name, sched_dep_time) %>% arrange(sched_dep_time)

flights %>% filter(origin == 'JFK' & dest == "LAX" & month == 1 & day == 1) %>% 
  select(carrier, dep_delay, arr_delay) %>% group_by(carrier) %>% 
  summarise(m_dep_delay = mean(dep_delay, na.rm = T),
            m_arr_delay = mean(arr_delay, na.rm = T))

flights %>% filter(origin == 'JFK' & dest == "LAX" & month == 1 & day == 1) %>%
  left_join(planes, by = "tailnum") %>% 
  summarise(n_seats = sum(seats, na.rm = T))

flights %>% filter(origin == 'JFK' & dest == "LAX" & month == 1 & day == 1) %>%
  left_join(planes, by = "tailnum") %>% group_by(carrier) %>% 
  summarise(n_seats = sum(seats, na.rm = T))

flights %>% filter(origin == 'JFK' & dest == "LAX" & month == 1 & day == 1) %>%
  left_join(planes, by = "tailnum") %>% group_by(carrier) %>% 
  summarise(n_seats = sum(seats, na.rm = T)) %>% 
  left_join(airlines, by = "carrier") %>% 
  select(name, carrier, n_seats)


